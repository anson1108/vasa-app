{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProjectExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::492213594399:role/personal-ec2-switch-ControlRole-*",
        "arn:aws:iam::492213594399:role/personal-ec2-switch-DnsWorkerRole-*"
      ]
    },
    {
      "Sid": "PassProjectRolesToLambda",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::492213594399:role/personal-ec2-switch-ControlRole-*",
        "arn:aws:iam::492213594399:role/personal-ec2-switch-DnsWorkerRole-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
